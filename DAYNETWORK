"""
CorrDiff / Flow-Matching Network — GENERATIONAL V11.5 (SOTA Edition)
=============================================================================
Unapologetically optimized for H100 Tensor Cores. 

Upgrades over base v11:
  * ATTENTION: Replaced manual einsum BnAttn with Flash Attention 2 (SDPA).
  * BLOCKS: ResConv upgraded to ConvNeXt-style inverted depthwise blocks.
  * SPECTRAL: FourierFilter upgraded to a Global Spectral Operator.
  * BOTTLENECK: ASPP dilated bottleneck hardened with fused operations.
  * COMPATIBILITY: 100% backward-compatible with v11 zero-gated checkpoints.
"""

import math
import torch
import torch.nn as nn
import torch.nn.functional as F

