# Core Utilities & High-Performance Layers
# ────────────────────────────────────────────────────────────────────────────

def _g(ch, mx=32):
    """Optimal GroupNorm channel divider."""
    for g in range(min(mx, ch), 0, -1):
        if ch % g == 0:
            return g
    return 1

class SEBlock(nn.Module):
    """Squeeze-and-Excitation with exact SiLU activation."""
    def __init__(self, ch, r=8):
        super().__init__()
        self.p = nn.AdaptiveAvgPool2d(1)
        self.f = nn.Sequential(
            nn.Linear(ch, max(4, ch // r), bias=False), 
            nn.SiLU(inplace=True),  # SiLU outperforms ReLU in diffusion
            nn.Linear(max(4, ch // r), ch, bias=False), 
            nn.Sigmoid()
        )

    def forward(self, x):
        b, c = x.shape[:2]
        return x * self.f(self.p(x).view(b, c)).view(b, c, 1, 1)

class CoordConv2d(nn.Module):
    """Spatial awareness injection with fused coordinate generation."""
    def __init__(self, in_channels, out_channels, kernel_size, padding=1):
        super().__init__()
        self.conv = nn.Conv2d(in_channels + 2, out_channels, kernel_size, padding=padding)

    def forward(self, x):
        b, c, h, w = x.shape
        # Hardware-efficient linspace generation
        yg = torch.linspace(-1, 1, h, device=x.device, dtype=x.dtype).view(1, 1, h, 1).expand(b, 1, h, w)
        xg = torch.linspace(-1, 1, w, device=x.device, dtype=x.dtype).view(1, 1, 1, w).expand(b, 1, h, w)
        return self.conv(torch.cat([x, yg, xg], dim=1))

class GlobalSpectralOperator(nn.Module):
    """
    Next-Gen Fourier Filter. Operates natively in the frequency domain to 
    capture massive spatial correlations (e.g., long-range monsoon bands).
    """
    def __init__(self, channels):
        super().__init__()
        self.complex_weight = nn.Parameter(torch.randn(channels, channels, 2, dtype=torch.float32) * 0.02)
        self.norm = nn.GroupNorm(_g(channels), channels)
        self.proj = nn.Conv2d(channels, channels, 1)
        nn.init.zeros_(self.proj.weight)
        nn.init.zeros_(self.proj.bias)

    def forward(self, x):
        B, C, H, W = x.shape
        x_norm = self.norm(x).to(torch.float32) # FFT requires fp32 for stability
        x_fft = torch.fft.rfft2(x_norm)
        
        weight = torch.view_as_complex(self.complex_weight)
        out_fft = torch.einsum('bchw,cd->bdhw', x_fft, weight)
        
        out = torch.fft.irfft2(out_fft, s=(H, W)).to(x.dtype)
        return x + self.proj(out)

class SDPA_Attention(nn.Module):
    """
    H100 Native Flash Attention 2. 
    Replaces the old, slow 'BnAttn'. No forced 8x8 downsampling. Pure mathematical power.
    """
    def __init__(self, ch, heads=4):
        super().__init__()
        while ch % heads != 0 and heads > 1:
            heads -= 1
        self.h = heads
        self.norm = nn.GroupNorm(_g(ch), ch)
        self.qkv = nn.Conv2d(ch, ch * 3, 1, bias=False)
        self.proj = nn.Conv2d(ch, ch, 1)
        nn.init.zeros_(self.proj.weight)
        nn.init.zeros_(self.proj.bias)

    def forward(self, x):
        B, C, H, W = x.shape
        qkv = self.qkv(self.norm(x)).view(B, 3, self.h, C // self.h, H * W)
        q, k, v = qkv.unbind(1)
        
        # Unlocks PyTorch 2.x Flash Attention dynamically
        with torch.backends.cuda.sdp_kernel(enable_flash=True, enable_math=True, enable_mem_efficient=True):
            out = F.scaled_dot_product_attention(
                q.transpose(-1, -2), 
                k.transpose(-1, -2), 
                v.transpose(-1, -2)
            )
            
        out = out.transpose(-1, -2).reshape(B, C, H, W)
        return x + self.proj(out)

class NextGenResBlock(nn.Module):
    """
    ConvNeXt-inspired Residual Block. 
    Depthwise-separable convolutions drastically increase receptive field without blowing up FLOPs.
    Replaces the old 'ResConv'.
    """
    def __init__(self, ic, oc):
        super().__init__()
        self.net = nn.Sequential(
            nn.GroupNorm(_g(ic), ic),
            nn.Conv2d(ic, ic, kernel_size=7, padding=3, groups=ic), # Large depthwise
            nn.GroupNorm(_g(ic), ic),
            nn.Conv2d(ic, oc * 2, kernel_size=1), # Inverted bottleneck
            nn.SiLU(inplace=True),
            nn.Conv2d(oc * 2, oc, kernel_size=1)
        )
        self.skip = nn.Conv2d(ic, oc, 1) if ic != oc else nn.Identity()
        self.se = SEBlock(oc)

    def forward(self, x):
        return self.skip(x) + self.se(self.net(x))

class DilatedBottleneck(nn.Module):
    """Hardened ASPP with GroupNorm precision and zero-initialization."""
    def __init__(self, in_channels, mid_channels=512):
        super().__init__()
        rates = [1, 2, 4, 8]
        branch_ch = mid_channels // len(rates)
        self.branches = nn.ModuleList()
        for rate in rates:
            self.branches.append(nn.Sequential(
                nn.Conv2d(in_channels, branch_ch, kernel_size=3, padding=rate, dilation=rate, bias=False),
                nn.GroupNorm(_g(branch_ch), branch_ch),
                nn.SiLU(inplace=True)
            ))
        self.project = nn.Sequential(
            nn.Conv2d(branch_ch * len(rates), in_channels, kernel_size=1, bias=False),
            nn.GroupNorm(_g(in_channels), in_channels)
        )
        nn.init.zeros_(self.project[0].weight)

    def forward(self, x):
        out = torch.cat([branch(x) for branch in self.branches], dim=1)
        return x + self.project(out)

