def load_unet(ckpt_path, dev):
    ck = torch.load(ckpt_path, map_location=dev)
    tc = ck.get("t_cond", T_COND)
    unet = UNet(
        in_channels      = ck.get("unet_in_channels", UNET_IN_CH),
        out_channels     = 1,
        base_channels    = BASE_CH,
        channel_mult     = CHANNEL_MULT,
        num_res_blocks   = NRB,
        dropout          = 0.0,
        global_dim       = GLOBAL_DIM,
        topo_channels    = TOPO_CH,
        use_d2m          = True,
        d2m_channels     = ck.get("d2m_channels", UNET_D2M_CH),
        use_var_map      = True,
        var_map_channels = ck.get("var_map_channels", UNET_VAR_MAP_CH),
        temporal_frames  = tc,
    ).to(dev)
    if "ema_shadow" in ck:
        state = {k: v.to(dev) for k, v in ck["ema_shadow"].items()}
    else:
        state = {k.replace("module.", ""): v
                 for k, v in ck["model_state_dict"].items()}
    unet.load_state_dict(state)
    unet.eval()
    for p in unet.parameters():
        p.requires_grad_(False)
    return unet, tc


# ═══════════════════════════════════════════════════════════════════════════
# DDIM SAMPLER
# ═══════════════════════════════════════════════════════════════════════════
@torch.no_grad()
def ddim_sample(unet, mu, tc, tp, gf, d2m, var_map,
                edm_schedule, dev, autocast_dtype=torch.bfloat16):
    B      = mu.shape[0]
    x_t    = torch.randn_like(mu) * SIGMA_DATA
    sigmas = edm_schedule.to(dev)

    # ── FIX: clone mu so CUDA Graph replay cannot overwrite it ──
    mu = mu.clone()

    with torch.autocast(device_type="cuda", dtype=autocast_dtype):
        for i, sigma_cur in enumerate(sigmas):
            s_cur   = sigma_cur.view(1, 1, 1, 1)
            c_in    = 1. / torch.sqrt(s_cur**2 + SIGMA_DATA**2)
            c_out   = s_cur * SIGMA_DATA / torch.sqrt(s_cur**2 + SIGMA_DATA**2)
            c_skip  = SIGMA_DATA**2 / (s_cur**2 + SIGMA_DATA**2)
            c_n     = (sigma_cur.log() / 4).expand(B)
            x_in    = torch.cat([x_t, mu, tc], dim=1)
            D_pred  = unet(c_in * x_in, c_n, topo=tp,
                           global_features=gf, d2m=d2m,
                           var_map=var_map, T=T_COND)
            x0_hat  = c_skip * x_t[:, :1] + c_out * D_pred
            if i < len(sigmas) - 1:
                sigma_next = sigmas[i + 1].view(1, 1, 1, 1)
                x_t = x0_hat + sigma_next * (x_t - x0_hat) / s_cur.clamp(min=1e-8)
            else:
                x_t = x0_hat
    return x_t.float()

# ═══════════════════════════════════════════════════════════════════════════
# METRICS  (real space)
# ═══════════════════════════════════════════════════════════════════════════
def to_real(x_log):
    return torch.expm1(x_log.clamp(min=0.)).clamp(min=0.)

def real_pcc(pred_r, obs_r):
    B  = pred_r.shape[0]
    p  = pred_r.view(B, -1).float()
    o  = obs_r.view(B, -1).float()
    pm = p.mean(1, keepdim=True);  om = o.mean(1, keepdim=True)
    num   = ((p - pm) * (o - om)).sum(1)
    denom = (torch.sqrt(((p - pm)**2).sum(1)) *
             torch.sqrt(((o - om)**2).sum(1)) + 1e-8)
    return (num / denom).mean().item()

def real_rmse(pred_r, obs_r):
    return torch.sqrt(F.mse_loss(pred_r.float(), obs_r.float())).item()

def real_bias(pred_r, obs_r):
    return (pred_r.float().mean() - obs_r.float().mean()).item()

def fractions_skill_score(pred, target, threshold=5.0, window=5):
    p_bin  = (pred  > threshold).float()
    t_bin  = (target > threshold).float()
    p_frac = F.avg_pool2d(p_bin,  window, stride=1, padding=window // 2)
    t_frac = F.avg_pool2d(t_bin,  window, stride=1, padding=window // 2)
    mse    = ((p_frac - t_frac)**2).mean(dim=[-1, -2])
    ref    = (p_frac**2).mean(dim=[-1, -2]) + (t_frac**2).mean(dim=[-1, -2])
    return (1.0 - mse / (ref + 1e-8)).mean().item()

def crps_ensemble(samples, target):
    N   = samples.shape[0]
    mae = (samples - target.unsqueeze(0)).abs().mean(0)
    pair = (samples.unsqueeze(0) - samples.unsqueeze(1)).abs()
    return (mae - 0.5 / N / (N - 1) * pair.sum([0, 1])).mean().item()

def psd_tail_ratio(pred, target, hff=0.3):
    P = torch.fft.rfft2(pred.float()).abs()
    T = torch.fft.rfft2(target.float()).abs()
    c = int((1 - hff) * P.shape[-1])
    return (P[..., c:].mean() / (T[..., c:].mean() + 1e-8)).item()


# ═══════════════════════════════════════════════════════════════════════════
# TEST INDEX LOGIC
# ═══════════════════════════════════════════════════════════════════════════
def get_test_indices(dataset_total, train_frac=0.70, val_frac=0.10):
    n = dataset_total
    test_size = int(0.20 * n)
    # Testing indices are the first 20%
    return list(range(0, test_size))


# ═══════════════════════════════════════════════════════════════════════════
# MAIN INFERENCE
# ═══════════════════════════════════════════════════════════════════════════
def run_inference(args):
    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[INFO] Device: {dev}  |  "
          f"CUDA: {torch.cuda.get_device_name(0) if dev.type == 'cuda' else 'N/A'}")

    torch.backends.cudnn.benchmark            = True
    torch.backends.cuda.matmul.allow_tf32     = True
    torch.backends.cudnn.allow_tf32           = True
    os.makedirs(args.out_dir, exist_ok=True)

    # ── Load dataset (CPU) ────────────────────────────────────────────────
    print("[INFO] Loading dataset …")
    ds_full = UpscaleDataset(
        RF_PATH, ORO_PATH,
        d2m_file  = D2M_PATH,
        split     = "test",
        normalize = True,
        device    = "cpu",
    )
    N_total  = len(ds_full)
    test_idx = get_test_indices(N_total,
                                train_frac=args.train_frac,
                                val_frac=args.val_frac)
    print(f"[INFO] Dataset total={N_total}  test={len(test_idx)}"
          f"  [{test_idx[0]}..{test_idx[-1]}]")

    # ── Extract coordinates THE SAME WAY Dataset.py does ─────────────────
    #    This is the single source of truth for lat/lon in all saved NetCDFs
    lat_vals, lon_vals = extract_lat_lon_from_dataset(ds_full, RF_PATH)

    # ── Extract timestamps ────────────────────────────────────────────────
    test_times     = extract_timestamps_from_dataset(ds_full, RF_PATH, test_idx)
    test_years_arr = test_times.year.values
    test_years     = sorted(set(test_years_arr))
    print(f"[INFO] Test years: {test_years}")

    # ── Load models ───────────────────────────────────────────────────────
    print("[INFO] Loading regressor …")
    reg = load_regressor(args.reg_ckpt, dev)

    print("[INFO] Loading UNet …")
    unet, tc_from_ckpt = load_unet(args.unet_ckpt, dev)

    if args.compile:
        print("[INFO] Compiling models …")
        reg  = torch.compile(reg,  mode="reduce-overhead")
        unet = torch.compile(unet, mode="reduce-overhead")

    qdm = None
    if args.qdm_ckpt and os.path.exists(args.qdm_ckpt):
        print(f"[INFO] Loading QDM from {args.qdm_ckpt}")
        qdm = QDM.load(args.qdm_ckpt)

    edm_schedule = build_edm_schedule(args.edm_steps)

    # ── DataLoader ────────────────────────────────────────────────────────
    test_subset = Subset(ds_full, test_idx)
    loader = DataLoader(
        test_subset,
        batch_size        = args.batch,
        shuffle           = False,   # ORDER MATTERS — never shuffle
        num_workers       = 8,
        pin_memory        = True,
        persistent_workers= True,
        prefetch_factor   = 2,
        drop_last         = False,
    )

    H, W = ds_full.H, ds_full.W

    # Verify spatial dims match extracted coords (belt-and-suspenders)
    assert H == len(lat_vals), f"Spatial H={H} != lat array len={len(lat_vals)}"
    assert W == len(lon_vals), f"Spatial W={W} != lon array len={len(lon_vals)}"

    # ── Inference loop ────────────────────────────────────────────────────
    all_pred_log = []
    all_obs_log  = []
    all_samples  = []

    print("[INFO] Running inference …")
    t0 = time.time()
    processed = 0

    with torch.no_grad():
        for bi, batch in enumerate(loader):
            fp      = batch["fine"].to(dev, non_blocking=True)[:, PRECIP_CH:PRECIP_CH+1]
            topo_1c = batch["topo"].to(dev, non_blocking=True)
            xi_raw  = batch["coarse"].to(dev, non_blocking=True)
            var_map = batch["var_map"].to(dev, non_blocking=True)
            d2m     = batch["d2m"].to(dev, non_blocking=True) if "d2m" in batch else None
            gf      = torch.stack([batch["doy"], batch["hour"]], 1).float().to(dev, non_blocking=True)
            tc_inp  = build_temporal_cond(batch, dev, n_frames=T_COND)
            tp      = expand_topo(topo_1c)
            xi      = build_coarse_input(xi_raw, var_map)

            with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
                mu = reg(xi, topo=tp, global_features=gf, d2m=d2m)

            # ── FIX: clone once here so each ensemble member gets a clean copy ──
            mu_base = mu.clone()

            ens_samples = []
            for _ in range(args.n_ens):
                res_sample = ddim_sample(
                    unet, mu_base, tc_inp, tp, gf, d2m, var_map,
                    edm_schedule, dev, autocast_dtype=torch.bfloat16,
                )
                pred_log = mu_base.clone() + res_sample   # mu_base reused safely
                pred_log = PhysicsGuide.apply(pred_log, xi_raw,
                                              enforce_mass=True, enforce_dry=True)
                if qdm is not None:
                    pred_log = qdm.apply(pred_log)
                ens_samples.append(pred_log.cpu())

            ens_t         = torch.stack(ens_samples)       # [N_ens, B, 1, H, W]
            mean_pred_log = ens_t.mean(0)

            all_pred_log.append(mean_pred_log)
            all_obs_log.append(fp.cpu())
            all_samples.append(ens_t)

            processed += fp.shape[0]
            if (bi + 1) % 20 == 0:
                elapsed = time.time() - t0
                print(f"  [{processed}/{len(test_idx)}]  "
                      f"{processed / elapsed:.1f} samples/s")

    print(f"[INFO] Inference done in {time.time() - t0:.1f}s")

    pred_log_all = torch.cat(all_pred_log, dim=0)   # [N_test, 1, H, W]
    obs_log_all  = torch.cat(all_obs_log,  dim=0)
    samples_all  = torch.cat(all_samples,  dim=1)   # [N_ens, N_test, 1, H, W]

    pred_real_all = to_real(pred_log_all)
    obs_real_all  = to_real(obs_log_all)
    samples_real  = to_real(samples_all)

    # Verify output spatial shape matches coordinates exactly
    assert pred_real_all.shape[-2] == H, \
        f"Pred H={pred_real_all.shape[-2]} != coord H={H}"
    assert pred_real_all.shape[-1] == W, \
        f"Pred W={pred_real_all.shape[-1]} != coord W={W}"

    # ── Year-wise NetCDF + metrics ────────────────────────────────────────
    all_metrics = []

    for yr in test_years:
        mask = (test_years_arr == yr)
        n_yr = mask.sum()
        print(f"\n[Year {yr}]  n_samples={n_yr}")

        pr = pred_real_all[mask]        # [n_yr, 1, H, W]
        ob = obs_real_all[mask]
        sp = samples_real[:, mask]      # [N_ens, n_yr, 1, H, W]

        yr_times = test_times[mask]

        pred_np = pr.squeeze(1).numpy().astype(np.float32)   # [n_yr, H, W]
        obs_np  = ob.squeeze(1).numpy().astype(np.float32)

        # Verify spatial shape one more time before writing
        assert pred_np.shape[1] == len(lat_vals), \
            f"[{yr}] pred H={pred_np.shape[1]} != lat len={len(lat_vals)}"
        assert pred_np.shape[2] == len(lon_vals), \
            f"[{yr}] pred W={pred_np.shape[2]} != lon len={len(lon_vals)}"

        ds_out = xr.Dataset(
            {
                "precipitation_predicted": (
                    ["time", "lat", "lon"], pred_np,
                    {"units": "mm/day",
                     "long_name": "CorrDiff 25km downscaled precipitation"},
                ),
                "precipitation_observed": (
                    ["time", "lat", "lon"], obs_np,
                    {"units": "mm/day",
                     "long_name": "IMD 25km observed precipitation"},
                ),
            },
            coords={
                "time": yr_times.values,
                "lat":  lat_vals,          # ← same sort+crop as Dataset.py
                "lon":  lon_vals,          # ← same sort+crop as Dataset.py
            },
            attrs={
                "description": f"CorrDiff 25km downscaled precipitation — {yr}",
                "model":       "CorrDiff EDM Residual v12 WassDiff",
                "sigma_data":  SIGMA_DATA,
                "n_ensemble":  args.n_ens,
                "edm_steps":   args.edm_steps,
                "qdm_applied": str(qdm is not None),
                "lat_source":  f"RF_PATH sortby+crop to H={H}",
                "lon_source":  f"RF_PATH sortby+crop to W={W}",
            },
        )

        nc_path = os.path.join(args.out_dir, f"corrdiff_25km_{yr}.nc")
        ds_out.to_netcdf(nc_path, encoding={
            "precipitation_predicted": {"zlib": True, "complevel": 4, "dtype": "float32"},
            "precipitation_observed":  {"zlib": True, "complevel": 4, "dtype": "float32"},
        })
        print(f"  Saved → {nc_path}")

        pcc  = real_pcc(pr, ob)
        rmse = real_rmse(pr, ob)
        bias = real_bias(pr, ob)
        fss5 = fractions_skill_score(pr, ob, threshold=5.0,  window=5)
        fss20= fractions_skill_score(pr, ob, threshold=20.0, window=5)
        psd  = psd_tail_ratio(pr, ob)
        crps = crps_ensemble(sp, ob)

        obs_flat  = ob.flatten().numpy()
        pred_flat = pr.flatten().numpy()

        all_metrics.append({
            "year":      yr,
            "n_samples": int(n_yr),
            "PCC_real":  round(pcc,  4),
            "RMSE_real": round(rmse, 4),
            "Bias_real": round(bias, 4),
            "FSS_5mm":   round(fss5, 4),
            "FSS_20mm":  round(fss20, 4),
            "PSD_tail":  round(psd,  4),
            "CRPS_real": round(crps, 4),
            "P95_obs":   round(float(np.percentile(obs_flat,  95)), 3),
            "P95_pred":  round(float(np.percentile(pred_flat, 95)), 3),
            "P99_obs":   round(float(np.percentile(obs_flat,  99)), 3),
            "P99_pred":  round(float(np.percentile(pred_flat, 99)), 3),
        })
        print(f"  PCC={pcc:.4f}  RMSE={rmse:.4f}  Bias={bias:.4f}  "
              f"FSS5={fss5:.4f}  FSS20={fss20:.4f}  CRPS={crps:.4f}")

    # ── Overall metrics ───────────────────────────────────────────────────
    pcc_all  = real_pcc(pred_real_all, obs_real_all)
    rmse_all = real_rmse(pred_real_all, obs_real_all)
    bias_all = real_bias(pred_real_all, obs_real_all)
    fss5_all = fractions_skill_score(pred_real_all, obs_real_all, threshold=5.0,  window=5)
    fss20_all= fractions_skill_score(pred_real_all, obs_real_all, threshold=20.0, window=5)
    psd_all  = psd_tail_ratio(pred_real_all, obs_real_all)
    crps_all = crps_ensemble(samples_real, obs_real_all)

    obs_all_flat  = obs_real_all.flatten().numpy()
    pred_all_flat = pred_real_all.flatten().numpy()

    all_metrics.append({
        "year":      "ALL",
        "n_samples": int(pred_real_all.shape[0]),
        "PCC_real":  round(pcc_all,  4),
        "RMSE_real": round(rmse_all, 4),
        "Bias_real": round(bias_all, 4),
        "FSS_5mm":   round(fss5_all, 4),
        "FSS_20mm":  round(fss20_all, 4),
        "PSD_tail":  round(psd_all,  4),
        "CRPS_real": round(crps_all, 4),
        "P95_obs":   round(float(np.percentile(obs_all_flat,  95)), 3),
        "P95_pred":  round(float(np.percentile(pred_all_flat, 95)), 3),
        "P99_obs":   round(float(np.percentile(obs_all_flat,  99)), 3),
        "P99_pred":  round(float(np.percentile(pred_all_flat, 99)), 3),
    })

    df       = pd.DataFrame(all_metrics)
    csv_path = os.path.join(args.out_dir, "metrics_yearwise.csv")
    df.to_csv(csv_path, index=False)
    print(f"\n[METRICS] Saved → {csv_path}")
    print(df.to_string(index=False))
    print(f"\n[DONE]  Overall PCC (real) = {pcc_all:.4f}")


