class InferenceDataset(torch.utils.data.Dataset):
    def __init__(self, nc_file, oro_file, d2m_file, scale_factor=4):
        self.scale_factor = scale_factor
        ds = xr.open_dataset(nc_file)
        var_name = next((v for v in ds.data_vars if any(k.lower() in v.lower() for k in PRECIP_KEYWORDS)), None)
        if var_name is None:
            raise ValueError(f"No precip var in {nc_file}")
        data = np.clip(np.nan_to_num(ds[var_name].values.astype(np.float32), nan=0.0), 0, None)
        H_c, W_c = (data.shape[1]//4)*4, (data.shape[2]//4)*4
        data = data[:, :H_c, :W_c]
        self.Hc, self.Wc = H_c, W_c
        self.Hf, self.Wf = H_c*scale_factor, W_c*scale_factor
        data = np.log1p(data)
        self.coarse = torch.from_numpy(data).unsqueeze(1).contiguous()
        time_var = next((t for t in ds.coords if t.upper() in ['TIME','TIMES','T']), 'TIME')
        self.times = pd.to_datetime(ds[time_var].values)
        self.doy  = torch.tensor(self.times.dayofyear.values/366.0, dtype=torch.float32)
        self.hour = torch.tensor(self.times.hour.values/24.0,       dtype=torch.float32)
        var_map = np.var(data, axis=0)
        vmin, vmax = var_map.min(), var_map.max()
        if vmax-vmin > 1e-7: var_map = (var_map-vmin)/(vmax-vmin+1e-8)
        self.var_map = torch.from_numpy(var_map).float().unsqueeze(0).contiguous()
        ds_oro   = xr.open_dataset(oro_file)
        topo_var = next((v for v in ds_oro.data_vars if 'topo' in v.lower() or 'elev' in v.lower()), list(ds_oro.data_vars)[0])
        topo = np.nan_to_num(ds_oro[topo_var].values.astype(np.float32), nan=0.0)
        topo = (topo-topo.mean())/(topo.std()+1e-8)
        self.topo = torch.from_numpy(topo).unsqueeze(0).unsqueeze(0).contiguous()
        ds_d2m  = xr.open_dataset(d2m_file)
        d2m_var = next((v for v in ds_d2m.data_vars if 'd2m' in v.lower() or 'dew' in v.lower()), list(ds_d2m.data_vars)[0])
        d2m = ds_d2m[d2m_var].values.astype(np.float32)
        if d2m.ndim==4: d2m = d2m[:,0]
        d2m = np.nan_to_num(d2m, nan=0.0)
        if d2m.mean()>100: d2m -= 273.15
        d2m = (d2m-float(np.nanmean(d2m)))/(float(np.nanstd(d2m))+1e-8)
        self.d2m = torch.from_numpy(d2m).unsqueeze(1).contiguous()

    def __len__(self): return self.coarse.shape[0]

    def __getitem__(self, idx):
        return {"coarse": self.coarse[idx], "topo": self.topo[0],
                "d2m": self.d2m[idx], "var_map": self.var_map,
                "doy": self.doy[idx], "hour": self.hour[idx]}


def build_edm_schedule(n_steps, sigma_min=0.002, sigma_data=SIGMA_DATA, rho=7.0):
    sigma_max = 2.0*sigma_data
    steps = torch.arange(n_steps, dtype=torch.float32)/max(n_steps-1,1)
    return (sigma_max**(1/rho)+steps*(sigma_min**(1/rho)-sigma_max**(1/rho)))**rho

def compute_slope_aspect(elev):
    kx = torch.tensor([[-1,0,1],[-2,0,2],[-1,0,1]], dtype=torch.float32, device=elev.device).view(1,1,3,3)
    ky = torch.tensor([[-1,-2,-1],[0,0,0],[1,2,1]], dtype=torch.float32, device=elev.device).view(1,1,3,3)
    e=elev.float(); dx=F.conv2d(e,kx,padding=1); dy=F.conv2d(e,ky,padding=1)
    slope=torch.sqrt(dx**2+dy**2+1e-8); aspect=torch.atan2(dy,dx)
    def norm(t): mn=t.amin(); mx=t.amax(); return 2*(t-mn)/(mx-mn+1e-8)-1
    return torch.cat([norm(e),norm(slope),norm(aspect)],dim=1)

def expand_topo(t): return torch.cat([compute_slope_aspect(t[i:i+1]) for i in range(t.shape[0])],dim=0)

def build_coarse_input(coarse, var_map):
    return torch.cat([coarse, F.adaptive_avg_pool2d(var_map,(coarse.shape[-2],coarse.shape[-1]))],dim=1)

@torch.no_grad()
def ddim_sample(model, mu, tc, tp, gf, d2m, var_map, sched, dev):
    x_t = torch.randn_like(mu)*SIGMA_DATA
    sigmas = sched.to(dev)
    for i, sigma_cur in enumerate(sigmas):
        s=sigma_cur.view(1,1,1,1)
        c_in=1./torch.sqrt(s**2+SIGMA_DATA**2)
        c_out=s*SIGMA_DATA/torch.sqrt(s**2+SIGMA_DATA**2)
        c_skip=SIGMA_DATA**2/(s**2+SIGMA_DATA**2)
        c_n=(sigma_cur.log()/4).expand(mu.shape[0])
        D=model(c_in*torch.cat([x_t,mu,tc],dim=1),c_n,topo=tp,global_features=gf,d2m=d2m,var_map=var_map,T=T_COND)
        x0=c_skip*x_t[:,:1]+c_out*D
        if i<len(sigmas)-1:
            sn=sigmas[i+1].view(1,1,1,1)
            x_t=x0+sn*(x_t-x0)/s.clamp(1e-8)
        else: x_t=x0
    return x_t


class CorrDiffInference:
    def __init__(self, reg_ckpt, unet_ckpt, qdm_ckpt, device, n_ens=4):
        self.dev=device; self.n_ens=n_ens
        ck_r=torch.load(reg_ckpt,map_location=device)
        self.reg=CorrDiffRegressor(in_channels=2,out_channels=1,base_channels=64,
                                   channel_mult=(1,2,4),num_blocks=2,global_dim=2,
                                   topo_channels=3,d2m_channels=1,use_d2m=True).to(device)
        self.reg.load_state_dict(ck_r.get("model_state_dict",ck_r),strict=False)
        self.reg.eval()
        ck_u=torch.load(unet_ckpt,map_location=device)
        self.tc=ck_u.get("t_cond",T_COND)
        self.sched=build_edm_schedule(N_STEPS,sigma_data=ck_u.get("sigma_data",SIGMA_DATA))
        self.unet=UNet(in_channels=ck_u.get("unet_in_channels",UNET_IN),out_channels=1,
                       base_channels=160,channel_mult=(1,2,2,4),num_res_blocks=3,dropout=0.,
                       global_dim=2,topo_channels=3,use_d2m=True,d2m_channels=1,
                       use_var_map=True,var_map_channels=1,temporal_frames=self.tc).to(device)
        state=(({k:v.to(device) for k,v in ck_u["ema_shadow"].items()}) if "ema_shadow" in ck_u
               else {k.replace("module.",""):v for k,v in ck_u["model_state_dict"].items()})
        self.unet.load_state_dict(state,strict=False); self.unet.eval()
        self.qdm=QDM.load(qdm_ckpt) if qdm_ckpt and os.path.exists(qdm_ckpt) else None

    @torch.no_grad()
    def predict(self, coarse, var_map, topo, d2m, doy, hour, tc_frames):
        dev=self.dev
        coarse,var_map,topo,d2m=coarse.to(dev),var_map.to(dev),topo.to(dev),d2m.to(dev)
        tc_frames=tc_frames.to(dev)
        gf=torch.stack([doy.to(dev),hour.to(dev)],dim=1).float()
        xi=build_coarse_input(coarse,var_map); tp=expand_topo(topo)
        with torch.autocast(device_type=dev.type,dtype=torch.bfloat16):
            mu=self.reg(xi,topo=tp,global_features=gf,d2m=d2m)
            samples=[PhysicsGuide.apply(ddim_sample(self.unet,mu,tc_frames,tp,gf,d2m,var_map,self.sched,dev)+mu,
                                        coarse,enforce_mass=True,enforce_dry=True) for _ in range(self.n_ens)]
            mean_pred=torch.stack(samples).float().mean(0)
            if self.qdm is not None and self.qdm._fitted:
                mean_pred=self.qdm.apply(mean_pred)
        return mean_pred


def build_tc_batch(dataset, indices, Hf, Wf):
    out=[]
    for idx in indices:
        frames=[F.interpolate(dataset.coarse[max(0,idx-k)].unsqueeze(0).float(),(Hf,Wf),mode='bilinear',align_corners=False)
                for k in range(T_COND,0,-1)]
        out.append(torch.cat(frames,dim=1))
    return torch.cat(out,dim=0)

def save_year(yr, preds, times, lats, lons):
    arr=np.concatenate(preds,axis=0)
    ds=xr.Dataset({"precipitation":(["time","latitude","longitude"],arr)},
                  coords={"time":np.array(times),"latitude":lats,"longitude":lons})
    ds["precipitation"].attrs.update({"units":"mm","long_name":"CorrDiff 6.25km Rainfall"})
    path=os.path.join(OUT_DIR,f"corrdiff_6km_{yr}.nc")
    ds.to_netcdf(path,encoding={"precipitation":{"zlib":True,"complevel":5}})

def main():
    torch.manual_seed(SEED); np.random.seed(SEED)
    os.makedirs(OUT_DIR,exist_ok=True)
    ds=InferenceDataset(COARSE_25KM_PATH,ORO_PATH,D2M_PATH)
    with xr.open_dataset(COARSE_25KM_PATH) as dc:
        lat_n=next((c for c in dc.coords if c.lower() in ['lat','latitude','lat_degrees']),None)
        lon_n=next((c for c in dc.coords if c.lower() in ['lon','longitude','lon_degrees']),None)
        if lat_n is None or lon_n is None: raise ValueError("No lat/lon coords found")
        lats=np.linspace(dc[lat_n].values[0],dc[lat_n].values[-1],ds.Hf)
        lons=np.linspace(dc[lon_n].values[0],dc[lon_n].values[-1],ds.Wf)
    inferencer=CorrDiffInference(REG_PATH,DIFF_PATH,QDM_PATH,DEVICE)
    cur_yr=None; yr_preds=[]; yr_times=[]
    indices = list(range(0, int(0.2 * len(ds))))
    for b_start in range(0,len(indices),BATCH_SIZE):
        batch=indices[b_start:b_start+BATCH_SIZE]
        b_c,b_t,b_d,b_dy,b_hr,b_vm=[],[],[],[],[],[]
        for i in batch:
            bv=ds[i]
            b_c.append(bv["coarse"])
            b_t.append(F.interpolate(bv["topo"].unsqueeze(0).float(),(ds.Hf,ds.Wf),mode='bilinear')[0])
            b_d.append(F.interpolate(bv["d2m"].unsqueeze(0).float(),(ds.Hf,ds.Wf),mode='bilinear')[0])
            b_dy.append(bv["doy"]); b_hr.append(bv["hour"]); b_vm.append(bv["var_map"])
        preds=inferencer.predict(torch.stack(b_c),torch.stack(b_vm),torch.stack(b_t),
                                 torch.stack(b_d),torch.stack(b_dy),torch.stack(b_hr),
                                 build_tc_batch(ds,batch,ds.Hf,ds.Wf))
        preds_np=np.maximum(np.expm1(preds.squeeze(1).cpu().numpy()),0.0)
        for b_idx,ds_idx in enumerate(batch):
            t=ds.times[ds_idx]; yr=t.year
            if cur_yr is not None and yr!=cur_yr:
                save_year(cur_yr,yr_preds,yr_times,lats,lons)
                yr_preds=[]; yr_times=[]
            cur_yr=yr
            yr_preds.append(np.expand_dims(preds_np[b_idx],0))
            yr_times.append(t)
    if yr_preds: save_year(cur_yr,yr_preds,yr_times,lats,lons)

