def extract_lat_lon_from_dataset(ds_full: UpscaleDataset, rf_path: str) -> tuple:
    """
    Extract lat/lon arrays that are GUARANTEED to match the spatial grid
    used inside UpscaleDataset — i.e. after sortby + crop to (H//16)*16.

    Returns
    -------
    lat_vals : np.ndarray  shape [H]
    lon_vals : np.ndarray  shape [W]
    """
    H, W = ds_full.H, ds_full.W

    ds_raw = xr.open_dataset(rf_path, engine="netcdf4")

    # Mirror Dataset.py: auto-detect coord names
    lat_name = next(
        (c for c in ds_raw.coords if c.lower() in ["lat", "latitude"]), None
    )
    lon_name = next(
        (c for c in ds_raw.coords if c.lower() in ["lon", "longitude"]), None
    )
    if lat_name is None or lon_name is None:
        raise RuntimeError(
            f"Cannot find lat/lon in {rf_path}. "
            f"Available coords: {list(ds_raw.coords)}"
        )

    # Mirror Dataset.py: sort ascending
    ds_raw = ds_raw.sortby([lat_name, lon_name])

    lat_vals = ds_raw[lat_name].values[:H].astype(np.float64)
    lon_vals = ds_raw[lon_name].values[:W].astype(np.float64)
    ds_raw.close()

    # Sanity: lengths must match dataset spatial dims
    assert len(lat_vals) == H, (
        f"lat length {len(lat_vals)} != dataset H={H}. "
        "Crop mismatch between Dataset.py and coord extraction."
    )
    assert len(lon_vals) == W, (
        f"lon length {len(lon_vals)} != dataset W={W}. "
        "Crop mismatch between Dataset.py and coord extraction."
    )

    print(f"[COORDS] lat: {lat_vals[0]:.4f} → {lat_vals[-1]:.4f}  (n={H})")
    print(f"[COORDS] lon: {lon_vals[0]:.4f} → {lon_vals[-1]:.4f}  (n={W})")
    return lat_vals, lon_vals


